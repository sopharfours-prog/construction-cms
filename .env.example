# ─────────────────────────────────────────────────────────────
# Construction CMS — environment template
# Copy to .env (development, Docker) or set in your host's dashboard (Vercel).
# Never commit real values. See SETUP.md and DEPLOYMENT.md.
# ─────────────────────────────────────────────────────────────

# Public site URL, no trailing slash. Required for production builds.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Let search engines index the public site. Set true on production ONLY;
# staging and development stay out of search results (robots.txt blocks all).
ALLOW_INDEXING=false

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/construction_cms?schema=public

# ─── Authentication (Auth.js) ────────────────────────────────────────────────
# Required. At least 32 characters: generate with  openssl rand -base64 32
AUTH_SECRET=
# Public URL of the site, exactly as visitors reach it. Required when
# self-hosting in production (Docker, Nginx); Vercel sets it automatically.
# Use AUTH_URL, not the old NEXTAUTH_URL: only AUTH_URL marks the host as
# trusted, and without it every sign-in fails with "UntrustedHost" (HTTP 500).
AUTH_URL=http://localhost:3000
# Set to true only behind a reverse proxy you control that sets Host and
# X-Forwarded-* headers (Nginx). Not needed when AUTH_URL is set, or on Vercel.
AUTH_TRUST_HOST=

# Public "Register" button: lets anyone ask for a CMS staff account. Requests
# wait as "Awaiting approval" and cannot sign in until an administrator assigns
# a role and activates them. Set to false to remove the button and the form.
ALLOW_REGISTRATION=true

# Live chat bubble on the public site. Staff answer under Live chat in the CMS.
# Set to false to remove the bubble (the chat API then answers 404).
ALLOW_CHAT=true

# ─── Email (password links, request notifications, replies) ──────────────────
# Without SMTP_HOST, development prints emails to the server console;
# production refuses to send (the error is logged; requests are never lost).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Construction CMS <no-reply@example.com>"

# ─── Seed (npm run db:seed) ──────────────────────────────────────────────────
# First Super Administrator. The password is only read when the account does
# not exist yet (min 12 characters). Remove it from .env after seeding.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
# Sample projects/services/news. Defaults to true, or false when NODE_ENV=production.
SEED_SAMPLE_DATA=true
# Optional: creates one demo account per role (administrator@, editor@,
# projects@, viewer@example.com) with this password. Leave empty in production.
SEED_DEMO_USER_PASSWORD=

# ─── File storage ────────────────────────────────────────────────────────────
# "local": files on disk under LOCAL_STORAGE_DIR, public files served at /media
#          (development, or one server with a persistent volume).
# "s3":    AWS S3, Cloudflare R2 or MinIO. Objects under public/ must be readable
#          by everyone (bucket policy, R2 public domain or CDN); private/ must not.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage

# For STORAGE_DRIVER=s3
#   AWS S3:  S3_ENDPOINT empty, S3_REGION=ap-southeast-1
#   R2:      S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto
#   MinIO:   S3_ENDPOINT=http://minio:9000, S3_FORCE_PATH_STYLE=true
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Public base URL of the bucket, e.g. https://files.example.com or https://<bucket>.s3.<region>.amazonaws.com
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false
# Let next/image fetch from a private-network address (MinIO on the LAN). Keep false otherwise.
IMAGES_ALLOW_LOCAL_IP=false

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Used only until one is
# set in Website Settings → SEO, which takes precedence.
GOOGLE_ANALYTICS_ID=
