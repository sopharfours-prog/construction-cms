# ─────────────────────────────────────────────────────────────
# Construction CMS — environment template
# Copy to .env.local (development) or set in your host's dashboard.
# Never commit real values. Each block notes the phase that reads it;
# variables for later phases can stay empty until then.
# ─────────────────────────────────────────────────────────────

# Public site URL, no trailing slash. Required for production builds.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 2: PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/construction_cms?schema=public

# Phase 3: Auth.js
# Required. At least 32 characters: generate with  openssl rand -base64 32
AUTH_SECRET=
# Public URL of the site, exactly as visitors reach it. Required when
# self-hosting in production (Docker, Nginx); Vercel sets it automatically.
# Use AUTH_URL, not the old NEXTAUTH_URL: only AUTH_URL marks the host as
# trusted, and without it every sign-in fails with "UntrustedHost" (HTTP 500).
AUTH_URL=http://localhost:3000
# Set to true only behind a reverse proxy you control that sets Host and
# X-Forwarded-* headers (Nginx). Not needed when AUTH_URL is set, or on Vercel.
AUTH_TRUST_HOST=

# Phase 3: email (password reset links). Without SMTP_HOST, development prints
# emails to the server console; production refuses to send.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Construction CMS <no-reply@example.com>"

# Phase 2 seed (npm run db:seed)
# First Super Administrator. The password is only read when the account does
# not exist yet (min 12 characters). Remove it from .env after seeding.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
# Sample projects/services/news. Defaults to true, or false when NODE_ENV=production.
SEED_SAMPLE_DATA=true
# Optional: creates one demo account per role (administrator@, editor@,
# projects@, viewer@example.com) with this password. Leave empty in production.
SEED_DEMO_USER_PASSWORD=

# Phase 6: object storage (AWS S3, Cloudflare R2 or MinIO)
STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=auto
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false

# Phase 10: analytics (GA4 measurement ID, e.g. G-XXXXXXXXXX)
GOOGLE_ANALYTICS_ID=
