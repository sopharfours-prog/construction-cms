# Production settings for docker-compose.prod.yml. Copy to .env.production
# (never commit it) and fill in every value marked "required".

# Public domain, without https:// (required). The site is https://$DOMAIN.
DOMAIN=example.com

# Required. openssl rand -base64 32
AUTH_SECRET=

# PostgreSQL (required password: openssl rand -base64 24)
POSTGRES_USER=cms
POSTGRES_PASSWORD=
POSTGRES_DB=construction_cms

# MinIO object storage (required; the password needs 8+ characters)
MINIO_ROOT_USER=cms-storage
MINIO_ROOT_PASSWORD=
S3_BUCKET=cms

# Email (strongly recommended: password links, request notifications, replies)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Company name <no-reply@example.com>"

# true only for the real production site
ALLOW_INDEXING=false

# Set true if $DOMAIN resolves to a private address (LAN-only server), so the
# image optimizer may fetch /files from it.
IMAGES_ALLOW_LOCAL_IP=false

# Optional; Website Settings → SEO takes precedence
GOOGLE_ANALYTICS_ID=

# First run only (docker compose … run --rm migrate npm run db:seed); remove afterwards.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_SAMPLE_DATA=false
